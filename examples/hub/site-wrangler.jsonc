{
  "name": "docs-site",
  "main": "site-worker.js",
  "compatibility_date": "2026-07-02",

  // SESSION_SECRET is a secret, and must differ per site.
  "vars": { "TELEGRAM_BOT_USERNAME": "your_bot" },

  // The hub's database, which holds the registry and the login table — copy the id from ./wrangler.jsonc.
  "d1_databases": [{ "binding": "HUB_DB", "database_name": "hub", "database_id": "<same id as the hub>" }],

  "observability": { "enabled": true }
}
