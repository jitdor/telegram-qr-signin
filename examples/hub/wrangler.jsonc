{
  "name": "telegram-qr-hub",
  "main": "hub-worker.js",
  "compatibility_date": "2026-07-02",

  // Secrets (wrangler secret put), never here:
  //   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, CONSOLE_SESSION_SECRET
  "vars": {
    "TELEGRAM_BOT_USERNAME": "your_bot",

    // Telegram numeric user ids of the people who can always get into the console. Find yours by
    // messaging @userinfobot. At least one is required.
    "SUPER_ADMINS": "123456789"
    // "QR_ORIGIN": "https://hub.example.com"
  },

  "d1_databases": [
    // The access list: sites, grants, blocks, super admins, requests, the audit log and the hash of
    // each site's key. Apply migrations/hub-d1.sql once. Back it up: it is the one durable thing here.
    // Only this Worker binds it; no site does.
    { "binding": "HUB_DB", "database_name": "hub", "database_id": "<from `wrangler d1 create hub`>" }
  ],

  // The in-flight sign-ins: a SQLite-backed Durable Object that creates its own tables. Strongly
  // consistent, which is why it is used instead of KV.
  "durable_objects": { "bindings": [{ "name": "QRAUTH_DO", "class_name": "QrAuthStorage" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QrAuthStorage"] }],

  "observability": { "enabled": true }
}
